# Optional read-only GitHub integration for the Kaviont Engineering Portal.
# Use a fine-grained token scoped only to repositories you intend to inspect.
KAVIONT_GITHUB_TOKEN=
# Optional GitHub Enterprise API base URL. Must use HTTPS.
# GITHUB_API_URL=https://api.github.com
# Repository that stores the Knowledge Hub Markdown documents.
KAVIONT_KNOWLEDGE_REPOSITORY=mohamadjaafri/kaviont-platform

# Optional in-cluster Kubernetes read-only integration.
# KAVIONT_KUBERNETES_NAMESPACE=default
# KUBERNETES_API_URL=https://kubernetes.default.svc
