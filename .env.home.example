# Copy to .env.home and replace the password before starting Kaviont.
# Generate a value with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_VALUE

# Optional read-only GitHub token for the Engineering Portal.
# Leave empty to run without the GitHub integration.
KAVIONT_GITHUB_TOKEN=

# Optional market polling configuration.
KRAKEN_POLL_INTERVAL_SECONDS=60
KRAKEN_MARKET_PAIR=XBTUSD

# Tailscale identity and role mapping. Use the exact login email shown by Tailscale.
# Empty admin list means every authenticated user is read-only.
KAVIONT_AUTH_MODE=tailscale
KAVIONT_ADMIN_USERS=
KAVIONT_READER_USERS=

# Optional read-only Kubernetes connection. The API endpoint must be reachable
# from the Kaviont container and its TLS certificate must validate.
KUBERNETES_API_URL=
KAVIONT_KUBERNETES_NAMESPACE=default

# Optional Azure read-only service principal.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional AWS credentials file: .kaviont-secrets/aws-credentials
AWS_REGION=eu-central-1

# Optional Google service-account credentials file:
# .kaviont-secrets/gcp-credentials.json
GOOGLE_CLOUD_PROJECT=
GCP_BILLING_PROJECT_ID=
GCP_BILLING_EXPORT_TABLE=
