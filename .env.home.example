# Copy to .env.home and replace the password before starting Kaviont.
# Generate a value with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_VALUE

# Optional read-only GitHub token for the Engineering Portal.
# Leave empty to run without the GitHub integration.
KAVIONT_GITHUB_TOKEN=

# Optional market polling configuration.
KRAKEN_POLL_INTERVAL_SECONDS=60
KRAKEN_MARKET_PAIR=XBTUSD
