{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(kaviont_http_server_request_duration_seconds_count[5m]))", "legendFormat": "requests/sec", "refId": "A"}],
      "title": "HTTP request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(kaviont_http_server_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "HTTP latency p95",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{"expr": "sum(rate(kaviont_http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(kaviont_http_server_request_duration_seconds_count[5m])), 1e-9)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "HTTP 5xx error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "tempo", "uid": "tempo"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 4,
      "targets": [{"queryType": "traceql", "query": "{ resource.service.name = \"hello-api\" }", "refId": "A"}],
      "title": "Recent hello-api traces",
      "type": "traces"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["kaviont", "observability", "fastapi"],
  "time": {"from": "now-1h", "to": "now"},
  "title": "Kaviont - Hello API",
  "uid": "kaviont-hello-api",
  "version": 1
}
