# Copy and configure this file with scripts/configure-gitops.py.
# It contains non-secret environment metadata only. Never put secret values here.
replicaCount: 2

image:
  repository: REPLACE_WITH_ACR_LOGIN_SERVER/hello-api
  tag: "0.2.0"
  pullPolicy: IfNotPresent

serviceAccount:
  create: true
  name: hello-api

workloadIdentity:
  enabled: true
  clientId: "REPLACE_WITH_HELLO_API_CLIENT_ID"
  keyVaultUrl: "REPLACE_WITH_KEY_VAULT_URI"
  secretName: platform-demo-token
